/*
 * Exercicio 09 — Inversao de Array com Ponteiros
 */
void inverter(int *arr, int n) {
    int *inicio = arr;
    int *fim    = arr + n - 1;
    int temp;

    while (inicio < fim) {
        temp    = *inicio;
        *inicio = *fim;
        *fim    = temp;
        inicio++;
        fim--;
    }
}

void exercicio09(void) {
    printf("=== Exercicio 09: Inversao de Array com Ponteiros ===\n");

    int v[7] = {10, 20, 30, 40, 50, 60, 70};
    int *p = v;
    int i;

    printf("  Antes : ");
    for (i = 0; i < 7; i++) printf("%d ", *(p + i));
    printf("\n");

    inverter(v, 7);

    printf("  Depois: ");
    for (i = 0; i < 7; i++) printf("%d ", *(p + i));
    printf("\n\n");
}

/*
 * Exercicio 10 — Busca em Matriz com Ponteiro
 * Percorre matriz 4x4 como array linear usando um unico ponteiro.
 */
void exercicio10(void) {
    printf("=== Exercicio 10: Busca em Matriz com Ponteiro ===\n");

    int mat[4][4] = {
        { 3, 17,  2, 99},
        {45,  8, 71, 12},
        {33, 56,  4, 88},
        {22, 11, 67, 15}
    };

    int *p   = &mat[0][0];
    int total = 4 * 4;
    int maior = *p;
    int idx   = 0;
    int i;

    for (i = 0; i < total; i++) {
        if (*(p + i) > maior) {
            maior = *(p + i);
            idx   = i;
        }
    }

    int linha  = idx / 4;
    int coluna = idx % 4;

    printf("  Maior valor: %d\n", maior);
    printf("  Posicao    : linha %d, coluna %d\n", linha, coluna);
    printf("\n");
}

