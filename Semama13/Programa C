/*
 * Exercicio 03 — Troca de Valores via Referencia
 * Funcao trocar recebe ponteiros e permuta os valores originais.
 */
void trocar(int *a, int *b) {
    int temp = *a;
    *a = *b;
    *b = temp;
}

void exercicio03(void) {
    printf("=== Exercicio 03: Troca de Valores via Referencia ===\n");

    int x = 10, y = 20;
    printf("  Antes : x = %d, y = %d\n", x, y);
    trocar(&x, &y);
    printf("  Depois: x = %d, y = %d\n", x, y);
    printf("\n");
}

/*
 * Exercicio 04 — Mapa de Enderecos de um Struct
 */
struct Aluno {
    char nome[50];
    int  matricula;
    float media;
};

void exercicio04(void) {
    printf("=== Exercicio 04: Mapa de Enderecos de um Struct ===\n");

    struct Aluno a;
    strcpy(a.nome, "Maria Silva");
    a.matricula = 20261001;
    a.media = 8.5f;

    printf("  Endereco de a          : %p\n", (void *)&a);
    printf("  Endereco de a.nome     : %p\n", (void *)&a.nome);
    printf("  Endereco de a.matricula: %p\n", (void *)&a.matricula);
    printf("  Endereco de a.media    : %p\n", (void *)&a.media);

    /*
     * Os campos de um struct sao alocados em ordem de declaracao,
     * em posicoes consecutivas na memoria. Porem, o compilador pode
     * inserir PADDING (bytes de alinhamento) entre campos para que
     * cada campo fique alinhado ao seu tamanho natural.
     * Por exemplo, apos o array 'nome[50]', o compilador pode
     * adicionar 2 bytes de padding antes de 'matricula' (int de 4 bytes)
     * para garanti-lo alinhado a multiplos de 4.
     * Por isso os enderecos sao "quase" consecutivos, mas podem ter
     * pequenos gaps de alinhamento entre eles.
     */

    printf("\n");
}

