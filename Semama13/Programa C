/*
 * Exercicio 11 — Funcao com Multiplos Retornos
 */
void estatisticas(int *v, int n, int *soma, float *media, int *maior, int *menor) {
    int *p   = v;
    int *fim = v + n;

    *soma  = 0;
    *maior = *p;
    *menor = *p;

    while (p < fim) {
        *soma += *p;
        if (*p > *maior) *maior = *p;
        if (*p < *menor) *menor = *p;
        p++;
    }

    *media = (float)*soma / n;
}

void exercicio11(void) {
    printf("=== Exercicio 11: Funcao com Multiplos Retornos ===\n");

    int arr[6] = {12, 45, 7, 30, 18, 55};
    int soma, maior, menor;
    float media;

    estatisticas(arr, 6, &soma, &media, &maior, &menor);

    printf("  Array : 12 45 7 30 18 55\n");
    printf("  Soma  : %d\n",   soma);
    printf("  Media : %.2f\n", media);
    printf("  Maior : %d\n",   maior);
    printf("  Menor : %d\n",   menor);
    printf("\n");
}

/*
 * Exercicio 12 — Ordenacao por Selecao com Ponteiros (Selection Sort)
 * Usa exclusivamente aritmetica de ponteiros (sem []).
 */
void selectionSort(int *arr, int n) {
    int *i, *j, *min_ptr;

    for (i = arr; i < arr + n - 1; i++) {
        min_ptr = i;

        for (j = i + 1; j < arr + n; j++) {
            if (*j < *min_ptr) {
                min_ptr = j;
            }
        }

        if (min_ptr != i) {
            printf("    Trocando %d <-> %d: ", *i, *min_ptr);
            trocar(i, min_ptr);

            /* Imprime estado atual apos a troca */
            int *p = arr;
            while (p < arr + n) {
                printf("%d ", *p++);
            }
            printf("\n");
        }
    }
}

void exercicio12(void) {
    printf("=== Exercicio 12: Selection Sort com Ponteiros ===\n");

    int arr[8] = {64, 25, 12, 22, 11, 90, 3, 47};
    int *p = arr;
    int i;

    printf("  Antes: ");
    for (i = 0; i < 8; i++) printf("%d ", *(p + i));
    printf("\n\n  Trocas durante a ordenacao:\n");

    selectionSort(arr, 8);

    printf("\n  Depois: ");
    for (i = 0; i < 8; i++) printf("%d ", *(p + i));
    printf("\n\n");
}

