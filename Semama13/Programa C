/*
 * Exercicio 01 — Endereco na Memoria
 * Declarar variaveis int, float e char, criar ponteiros para cada
 * e imprimir: valor, endereco da variavel, endereco no ponteiro e
 * valor obtido via ponteiro.
 */
void exercicio01(void) {
    printf("=== Exercicio 01: Endereco na Memoria ===\n");

    int   vi = 42;
    float vf = 3.14f;
    char  vc = 'Z';

    int   *pi = &vi;
    float *pf = &vf;
    char  *pc = &vc;

    printf("\n[int]\n");
    printf("  Valor da variavel     : %d\n",   vi);
    printf("  Endereco da variavel  : %p\n",   (void *)&vi);
    printf("  Endereco no ponteiro  : %p\n",   (void *)pi);
    printf("  Valor via ponteiro    : %d\n",   *pi);

    printf("\n[float]\n");
    printf("  Valor da variavel     : %.2f\n", vf);
    printf("  Endereco da variavel  : %p\n",   (void *)&vf);
    printf("  Endereco no ponteiro  : %p\n",   (void *)pf);
    printf("  Valor via ponteiro    : %.2f\n", *pf);

    printf("\n[char]\n");
    printf("  Valor da variavel     : %c\n",   vc);
    printf("  Endereco da variavel  : %p\n",   (void *)&vc);
    printf("  Endereco no ponteiro  : %p\n",   (void *)pc);
    printf("  Valor via ponteiro    : %c\n",   *pc);

    printf("\n");
}

/*
 * Exercicio 02 — Tamanho de um Ponteiro
 *
 * O tamanho de um ponteiro NAO varia com o tipo apontado.
 * Em arquiteturas de 32 bits, todos os ponteiros ocupam 4 bytes.
 * Em arquiteturas de 64 bits, ocupam 8 bytes.
 * O tipo do ponteiro apenas informa ao compilador QUANTOS bytes
 * ler/escrever ao desreferenciar, mas o ponteiro em si guarda
 * apenas um endereco, cujo tamanho e fixo pela arquitetura.
 */
void exercicio02(void) {
    printf("=== Exercicio 02: Tamanho de um Ponteiro ===\n");

    printf("  sizeof(int *)    = %zu bytes\n", sizeof(int *));
    printf("  sizeof(float *)  = %zu bytes\n", sizeof(float *));
    printf("  sizeof(double *) = %zu bytes\n", sizeof(double *));
    printf("  sizeof(char *)   = %zu bytes\n", sizeof(char *));

    /*
     * Conclusao: todos os ponteiros acima possuem o mesmo tamanho.
     * O tamanho NAO depende do tipo apontado — depende apenas da
     * arquitetura (32 ou 64 bits) do sistema em que o codigo roda.
     */

    printf("\n");
}

